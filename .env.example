# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# URL, по которому backend отдаёт Web App (должен быть HTTPS в проде, для локальной разработки - ngrok/cloudflared)
WEBAPP_URL=https://your-domain.example.com

# Путь к файлу SQLite внутри контейнера backend (совпадает с volume ./data:/app/data)
DATABASE_URL=sqlite:////app/data/barbershop.db

# Telegram ID администратора(ов) для получения уведомлений о новых записях (через запятую)
ADMIN_IDS=123456789
